#!/bin/sh
# Block pushes that include commits with personal author/committer identity.
set -e

HOOK_DIR=$(dirname "$0")
if command -v powershell.exe >/dev/null 2>&1 && [ -f "$HOOK_DIR/pre-push.ps1" ]; then
  # Forward stdin (ref lines) and remote args to PowerShell.
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/pre-push.ps1" "$@"
  exit $?
fi

REQUIRED_NAME="BeanCounter11"
z40=0000000000000000000000000000000000000000
remote="$1"
url="$2"
failed=0

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ -z "$local_sha" ] || [ "$local_sha" = "$z40" ]; then
    continue
  fi

  if [ "$remote_sha" = "$z40" ] || [ -z "$remote_sha" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  while IFS="$(printf '\t')" read -r sha an ae cn ce
  do
    if [ "$an" != "$REQUIRED_NAME" ]; then
      echo "personal-data: $sha author name \"$an\" (must be $REQUIRED_NAME)"
      failed=1
    fi
    case "$ae" in
      *@users.noreply.github.com) ;;
      *)
        echo "personal-data: $sha author email \"$ae\""
        failed=1
        ;;
    esac
    if [ "$cn" != "$REQUIRED_NAME" ] && [ "$cn" != "GitHub" ]; then
      echo "personal-data: $sha committer name \"$cn\""
      failed=1
    fi
    case "$ce" in
      *@users.noreply.github.com|noreply@github.com) ;;
      *)
        echo "personal-data: $sha committer email \"$ce\""
        failed=1
        ;;
    esac
  done <<EOF
$(git log --format='%H%x09%an%x09%ae%x09%cn%x09%ce' "$range")
EOF
done

if [ "$failed" -ne 0 ]; then
  echo "personal-data: refusing push to $remote ($url)."
  exit 1
fi

exit 0
